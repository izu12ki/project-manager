{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test:e2e": "playwright test",
		"gen": "wrangler types",
		"holidays:fetch": "node scripts/fetch-holidays.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:local": "turso dev --db-file local.db --port 8080",
		"deploy": "pnpm build && wrangler deploy",
		"deploy:preview": "pnpm build && wrangler deploy --env preview"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/hast": "^3.0.5",
		"@types/linkify-it": "^5.0.0",
		"@types/markdown-it": "^14.2.0",
		"@types/mdast": "^4.0.4",
		"@types/node": "^24",
		"drizzle-kit": "1.0.0-rc.4",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"markdown-it": "15.0.2",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"wrangler": "^4.97.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "1.7.7",
		"@libsql/client": "0.18.0",
		"@lucide/svelte": "^1.52.0",
		"better-auth": "1.7.7",
		"drizzle-orm": "1.0.0-rc.4",
		"fractional-indexing": "4.0.0",
		"hast-util-to-html": "9.0.5",
		"linkify-it": "6.1.0",
		"mdast-util-from-markdown": "2.1.0",
		"mdast-util-gfm-strikethrough": "2.0.1",
		"mdast-util-gfm-table": "2.0.0",
		"mdast-util-gfm-task-list-item": "2.0.0",
		"mdast-util-to-hast": "13.2.1",
		"mdast-util-to-markdown": "^2.2.0",
		"micromark-extension-gfm-strikethrough": "2.1.0",
		"micromark-extension-gfm-table": "2.1.2",
		"micromark-extension-gfm-task-list-item": "2.1.0",
		"micromark-util-sanitize-uri": "2.0.1",
		"micromark-util-types": "^2.0.3",
		"svelte-dnd-action": "0.9.80",
		"uuidv7": "1.2.1",
		"valibot": "1.5.0"
	}
}
