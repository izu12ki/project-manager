{
	"name": "web",
	"private": true,
	"version": "0.5.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types && vite build",
		"preview": "wrangler dev --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test:e2e": "playwright test",
		"perf:server": "bash scripts/perf-server.sh",
		"gen": "wrangler types",
		"holidays:fetch": "node scripts/fetch-holidays.ts",
		"db:generate": "drizzle-kit generate",
		"db:sync": "node scripts/d1-migrations.ts",
		"db:migrate:local": "pnpm db:sync && wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "pnpm db:sync && wrangler d1 migrations apply DB --remote",
		"deploy": "pnpm build && wrangler deploy"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@libsql/client": "0.18.0",
		"@playwright/test": "^1.64.1",
		"@rolldown/perf-kit": "^0.1.0",
		"@sveltejs/adapter-cloudflare": "^9.0.0",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.4",
		"@types/hast": "^3.0.5",
		"@types/linkify-it": "^5.0.0",
		"@types/markdown-it": "^14.2.0",
		"@types/mdast": "^4.0.4",
		"@types/node": "^26.6.6",
		"drizzle-kit": "1.0.0-rc.6",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.0",
		"globals": "^17.14.0",
		"happy-dom": "^21.0.4",
		"markdown-it": "15.0.3",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.6",
		"vitest": "^5.1.0",
		"wrangler": "^4.158.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "1.7.27",
		"@lexical/clipboard": "0.53.0",
		"@lexical/code-core": "0.53.0",
		"@lexical/extension": "0.53.0",
		"@lexical/history": "0.53.0",
		"@lexical/html": "0.53.0",
		"@lexical/link": "0.53.0",
		"@lexical/list": "0.53.0",
		"@lexical/mdast": "0.53.0",
		"@lexical/rich-text": "0.53.0",
		"@lexical/selection": "0.53.0",
		"@lexical/utils": "0.53.0",
		"@lucide/svelte": "^1.69.0",
		"better-auth": "1.7.27",
		"diff": "9.0.0",
		"drizzle-orm": "1.0.0-rc.6",
		"fractional-indexing": "4.0.0",
		"hast-util-to-html": "9.0.7",
		"lexical": "0.53.0",
		"linkify-it": "6.1.0",
		"mdast-util-from-markdown": "2.1.0",
		"mdast-util-gfm-strikethrough": "2.0.1",
		"mdast-util-gfm-table": "2.0.1",
		"mdast-util-gfm-task-list-item": "2.0.1",
		"mdast-util-to-hast": "13.2.2",
		"mdast-util-to-markdown": "^2.2.2",
		"micromark-extension-gfm-strikethrough": "2.1.0",
		"micromark-extension-gfm-table": "2.1.2",
		"micromark-extension-gfm-task-list-item": "2.1.0",
		"micromark-util-sanitize-uri": "2.0.1",
		"micromark-util-types": "^2.0.3",
		"svelte-dnd-action": "0.9.81",
		"uuidv7": "1.2.1",
		"valibot": "1.5.0"
	}
}
