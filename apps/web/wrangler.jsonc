{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "project-manager",
	"compatibility_date": "2026-10-09",
	"compatibility_flags": ["nodejs_compat"],
	// main と assets.directory は adapter-cloudflare がビルド時に設定する（vite build が .wrangler/deploy/config.json を書き、wrangler dev / deploy はそれを読む）
	"assets": { "binding": "ASSETS" },
	"workers_dev": true,
	"preview_urls": true,
	"observability": { "enabled": true },
	// 添付ファイル。バケットは `wrangler r2 bucket create project-manager-attachments` で作る
	"r2_buckets": [{ "binding": "BUCKET", "bucket_name": "project-manager-attachments" }],
	// メール送信（Cloudflare Email Sending）。MAIL_PROVIDER=cloudflare のときだけ使う
	"send_email": [{ "name": "EMAIL" }],
	// Turso（aws-ap-northeast-1）の近くで実行し、DB 往復を短くする
	"placement": { "region": "aws:ap-northeast-1" }
}
